{
  "manifestVersion": "1.0",
  "appId": "cascade",
  "patches": [
    {
      "name": "valid-url-appid-precedence",
      "file": "app/viewer-min.js",
      "find": "getAppID:function(e){var t=this.getUrlParams();return app.indexCfg",
      "replace": "getAppID:function(e){var t=this.getUrlParams();if(typeof t.appid===\"string\"&&/^[a-f0-9]{32}$/i.test(t.appid))return t.appid;return app.indexCfg"
    },
    {
      "name": "bounded-share-url-query-filter",
      "file": "app/viewer-min.js",
      "find": "{key:\"getStoryURL\",value:function(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:{},t=e.url||document.location.href;return t=t.replace(/\\?edit(=.*)*&/,\"?\"),t=t.replace(/\\&edit(=.*)*/,\"\"),t=t.replace(/\\?edit/,\"\"),t=t.replace(/\\?locale(=[a-zA-Z\\-]+)+&/,\"?\"),t=t.replace(/\\&locale(=[a-zA-Z\\-]+)+/,\"\"),e.urlEncoding?encodeURIComponent(t):t}}",
      "replace": "{key:\"getStoryURL\",value:function(params){params=params||{};var url=new URL(params.url||document.location.href,document.location.href);url.searchParams.delete(\"edit\");url.searchParams.delete(\"locale\");return params.urlEncoding?encodeURIComponent(url.href):url.href}}"
    }
  ],
  "release": {
    "version": "1.23.0",
    "url": "https://github.com/Esri/storymap-cascade/releases/download/V1.23.0/Storymaps-Cascade-1.23.0.zip",
    "sha256": "40b68fd330b232571146ef7aaf0a3942069355e8a0f4cf0719a66d3b6a7a267e"
  },
  "displayName": "Story Map Cascade",
  "supportStage": "supported",
  "route": "/templates/classic-storymaps/cascade",
  "canonicalUrlPattern": "/templates/classic-storymaps/cascade",
  "compatibilityUrlPatterns": [
    "/templates/classic-storymaps/cascade/index.html"
  ],
  "upstream": {
    "repo": "storymap-cascade",
    "owner": "Esri",
    "refType": "commit",
    "ref": "df47322cf31bbf1d72768c829349477fce0514a9",
    "sourceSubpath": ".",
    "license": "Apache-2.0"
  },
  "build": {
    "tool": "grunt",
    "commands": [
      "npm ci",
      "grunt --force"
    ],
    "workingDirectory": "runtimes/cascade/upstream",
    "outputPath": "runtimes/cascade/build"
  }
}
